# Optional. Leave empty in dev — requests go to /api and the Vite proxy forwards
# them to the backend (http://localhost:8000). Set an absolute base only when the
# frontend is served from a different origin than the API.
VITE_API_BASE=

# Force the fixtures/sample-data layer even when the backend responds.
# "true" = always use bundled sample data. Anything else = live, with fixtures
# only as a fallback when the API is empty or unreachable.
VITE_USE_SAMPLE=
