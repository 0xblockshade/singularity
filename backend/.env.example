# infinitum backend — environment template.
# Copy to `.env` and fill in. NEVER commit a real .env or real secrets.
# `.env` is gitignored; only this .example file is tracked.

# ─── Secrets ─────────────────────────────────────────────────────────────────
# Anthropic API key for the live narrator (AnthropicNarrator). Without it, a wake
# skips cleanly instead of crashing. Not needed for tests or INFINITUM_FAKE runs.
ANTHROPIC_API_KEY=

# Token guarding the admin kill-switch endpoint (POST /api/admin/kill).
# Empty means the admin endpoint refuses everything (locked). Set a strong value in prod.
INFINITUM_ADMIN_TOKEN=

# ─── Autonomy / scheduler ────────────────────────────────────────────────────
# Start the in-process daily-wake scheduler when the FastAPI app boots.
# OFF by default so tests and API-only deploys never spawn it. Set true on the
# always-on machine that should wake the narrator. (truthy: 1/true/yes/on)
INFINITUM_ENABLE_SCHEDULER=false

# Hour (0-23) of the daily wake, in INFINITUM_TZ. Default 9.
INFINITUM_WAKE_HOUR=9

# Timezone for the wake schedule (IANA name). Default UTC.
INFINITUM_TZ=UTC

# Optional +/- seconds of random jitter on the wake fire time. Default 0 (sharp).
INFINITUM_WAKE_JITTER=0

# Force the deterministic FakeNarrator (no network, no API key) for a wake.
# Use for wiring checks / dry runs only. (truthy: 1/true/yes/on)
INFINITUM_FAKE=

# Log level for the standalone scheduler (python -m app.scheduler). Default INFO.
INFINITUM_LOG_LEVEL=INFO

# ─── Storage ─────────────────────────────────────────────────────────────────
# Data directory (mount a persistent volume here in prod). Default: backend/data.
INFINITUM_DATA=/data

# SQLite DB path. Default: <INFINITUM_DATA>/infinitum.db.
INFINITUM_DB=/data/infinitum.db

# ─── Models (overridable so a model bump is config, not code) ─────────────────
INFINITUM_NARRATOR_MODEL=claude-opus-5
INFINITUM_TRIAGE_MODEL=claude-haiku-4-5
INFINITUM_MAX_TOKENS=16000

# ─── World-scan adapters (Phase 4; owned by another module) ───────────────────
# Enable live signal scanning (RSS/arXiv) instead of stubbed signals. Default off.
INFINITUM_LIVE_SCAN=

# ─── Inbox guards & ritual tuning (metadata only; the agent still reads all) ──
INFINITUM_RATE_LIMIT=30
INFINITUM_DEDUP_WINDOW_MIN=60
INFINITUM_MAX_TX_CHARS=4000
INFINITUM_MAX_SIGNALS=60
INFINITUM_MAX_TX=200

# ─── Server ──────────────────────────────────────────────────────────────────
# Port uvicorn binds (Fly/Railway inject this). Default 8000.
PORT=8000
